@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shape: <urn:odrl-shapes:> .

#################################################################
# Prototype profile
#################################################################
# These shapes validate the atomic ODRL subset generated by the prototype.
# They are intentionally stricter than the complete, extensible ODRL model:
# only the policy types, actions, operators and left operands supported by the
# application are accepted.

#################################################################
# Policy
#################################################################

shape:PolicyShape
    a sh:NodeShape ;
    sh:targetNode <urn:odrl-validation:policy> ;

    sh:property [
        sh:path rdf:type ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            odrl:Policy
            odrl:Set
            odrl:Offer
            odrl:Agreement
            odrl:Request
        ) ;
        sh:severity sh:Violation ;
        sh:message "The policy must include exactly one supported @type: Policy, Set, Offer, Agreement or Request." ;
    ] ;

    sh:property [
        sh:path odrl:uid ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "The policy must include exactly one uid and it must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:profile ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Every profile value must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:inheritFrom ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Every inheritFrom value must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:conflict ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            odrl:prohibit
            odrl:perm
            odrl:invalid
        ) ;
        sh:severity sh:Violation ;
        sh:message "If conflict is present, it must be exactly one of: prohibit, perm or invalid." ;
    ] ;

    sh:or (
        [ sh:property [ sh:path odrl:permission ; sh:minCount 1 ] ]
        [ sh:property [ sh:path odrl:prohibition ; sh:minCount 1 ] ]
        [ sh:property [ sh:path odrl:obligation ; sh:minCount 1 ] ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "The policy must contain at least one permission, prohibition or obligation." .


#################################################################
# Policy-type-specific requirements
#################################################################

shape:AgreementShape
    a sh:NodeShape ;
    sh:targetClass odrl:Agreement ;
    sh:or (
        [
            sh:property [
                sh:path odrl:permission ;
                sh:qualifiedValueShape shape:RuleWithAssignerAndAssigneeShape ;
                sh:qualifiedMinCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path odrl:prohibition ;
                sh:qualifiedValueShape shape:RuleWithAssignerAndAssigneeShape ;
                sh:qualifiedMinCount 1 ;
            ]
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "An Agreement must contain at least one permission or prohibition with both assigner and assignee in the same rule." .

shape:OfferShape
    a sh:NodeShape ;
    sh:targetClass odrl:Offer ;
    sh:or (
        [
            sh:property [
                sh:path odrl:permission ;
                sh:qualifiedValueShape shape:RuleWithAssignerShape ;
                sh:qualifiedMinCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path odrl:prohibition ;
                sh:qualifiedValueShape shape:RuleWithAssignerShape ;
                sh:qualifiedMinCount 1 ;
            ]
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "An Offer must contain at least one permission or prohibition with an assigner in that rule." .

shape:RequestShape
    a sh:NodeShape ;
    sh:targetClass odrl:Request ;
    sh:or (
        [
            sh:property [
                sh:path odrl:permission ;
                sh:qualifiedValueShape shape:RuleWithAssigneeShape ;
                sh:qualifiedMinCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path odrl:prohibition ;
                sh:qualifiedValueShape shape:RuleWithAssigneeShape ;
                sh:qualifiedMinCount 1 ;
            ]
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A Request must contain at least one permission or prohibition with an assignee in that rule." .

shape:SetShape
    a sh:NodeShape ;
    sh:targetClass odrl:Set ;
    sh:or (
        [
            sh:property [
                sh:path odrl:permission ;
                sh:qualifiedValueShape shape:RuleWithTargetShape ;
                sh:qualifiedMinCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path odrl:prohibition ;
                sh:qualifiedValueShape shape:RuleWithTargetShape ;
                sh:qualifiedMinCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path odrl:obligation ;
                sh:qualifiedValueShape shape:RuleWithTargetShape ;
                sh:qualifiedMinCount 1 ;
            ]
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A Set policy must contain at least one rule with a target asset." .

shape:RuleWithAssignerAndAssigneeShape
    a sh:NodeShape ;
    sh:property [
        sh:path odrl:assigner ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path odrl:assignee ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] .

shape:RuleWithAssignerShape
    a sh:NodeShape ;
    sh:property [
        sh:path odrl:assigner ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] .

shape:RuleWithAssigneeShape
    a sh:NodeShape ;
    sh:property [
        sh:path odrl:assignee ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] .

shape:RuleWithTargetShape
    a sh:NodeShape ;
    sh:property [
        sh:path odrl:target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] .


#################################################################
# Shared rule requirements
#################################################################

shape:RuleCoreShape
    a sh:NodeShape ;

    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "If a rule uid is present, it must be exactly one IRI." ;
    ] ;

    sh:property [
        sh:path odrl:action ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            odrl:use
            odrl:read
            odrl:modify
            odrl:distribute
            odrl:delete
            odrl:display
            odrl:print
            odrl:copy
            odrl:archive
            odrl:derive
            odrl:extract
            odrl:transform
            odrl:aggregate
            odrl:anonymize
            odrl:attribute
            odrl:compensate
            odrl:sell
        ) ;
        sh:severity sh:Violation ;
        sh:message "Each rule must include exactly one action supported by the prototype." ;
    ] ;

    sh:property [
        sh:path odrl:assigner ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "If assigner is present, it must be exactly one IRI." ;
    ] ;

    sh:property [
        sh:path odrl:assignee ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "If assignee is present, it must be exactly one IRI." ;
    ] ;

    sh:property [
        sh:path odrl:constraint ;
        sh:node shape:ConstraintShape ;
        sh:severity sh:Violation ;
        sh:message "Every constraint attached to the rule must conform to ConstraintShape." ;
    ] .


#################################################################
# Permission, prohibition and policy obligation
#################################################################

shape:PermissionShape
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:permission ;
    sh:node shape:RuleCoreShape ;

    sh:property [
        sh:path odrl:target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Each permission must include exactly one target asset as an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:duty ;
        sh:node shape:PermissionDutyShape ;
        sh:severity sh:Violation ;
        sh:message "Every duty attached to a permission must be a valid duty." ;
    ] ;

    sh:property [
        sh:path odrl:remedy ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A permission cannot contain remedy; use duty for permission preconditions." ;
    ] ;

    sh:property [
        sh:path odrl:consequence ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A consequence cannot be attached directly to a permission." ;
    ] .

shape:ProhibitionShape
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:prohibition ;
    sh:node shape:RuleCoreShape ;

    sh:property [
        sh:path odrl:target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Each prohibition must include exactly one target asset as an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:remedy ;
        sh:node shape:RemedyDutyShape ;
        sh:severity sh:Violation ;
        sh:message "Every remedy attached to a prohibition must be a valid duty." ;
    ] ;

    sh:property [
        sh:path odrl:duty ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A prohibition cannot contain duty; use remedy for infringement handling." ;
    ] ;

    sh:property [
        sh:path odrl:consequence ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A consequence cannot be attached directly to a prohibition." ;
    ] .

shape:ObligationShape
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:obligation ;
    sh:node shape:DutyCoreShape ;

    sh:property [
        sh:path odrl:consequence ;
        sh:node shape:ConsequenceDutyShape ;
        sh:severity sh:Violation ;
        sh:message "Every consequence attached to an obligation must be a valid duty." ;
    ] ;

    sh:property [
        sh:path odrl:duty ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A policy obligation cannot contain a nested duty property." ;
    ] ;

    sh:property [
        sh:path odrl:remedy ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A policy obligation cannot contain remedy." ;
    ] .


#################################################################
# Duty, consequence and remedy
#################################################################

shape:DutyCoreShape
    a sh:NodeShape ;
    sh:node shape:RuleCoreShape ;

    sh:property [
        sh:path odrl:target ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "If a duty contains target, it must be exactly one IRI." ;
    ] .

shape:PermissionDutyShape
    a sh:NodeShape ;
    sh:node shape:DutyCoreShape ;

    sh:property [
        sh:path odrl:consequence ;
        sh:node shape:ConsequenceDutyShape ;
        sh:severity sh:Violation ;
        sh:message "Every consequence attached to a permission duty must be a valid duty." ;
    ] ;

    sh:property [
        sh:path odrl:duty ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A duty cannot contain another duty property." ;
    ] ;

    sh:property [
        sh:path odrl:remedy ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A permission duty cannot contain remedy." ;
    ] .

shape:RemedyDutyShape
    a sh:NodeShape ;
    sh:node shape:DutyCoreShape ;

    sh:property [
        sh:path odrl:consequence ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A remedy duty must not contain a consequence." ;
    ] ;

    sh:property [
        sh:path odrl:duty ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A remedy duty cannot contain a nested duty property." ;
    ] ;

    sh:property [
        sh:path odrl:remedy ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A remedy duty cannot contain a nested remedy property." ;
    ] .

shape:ConsequenceDutyShape
    a sh:NodeShape ;
    sh:node shape:DutyCoreShape ;

    sh:property [
        sh:path odrl:consequence ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A consequence duty must not contain another consequence." ;
    ] ;

    sh:property [
        sh:path odrl:duty ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A consequence duty cannot contain a nested duty property." ;
    ] ;

    sh:property [
        sh:path odrl:remedy ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A consequence duty cannot contain remedy." ;
    ] .


#################################################################
# Constraints
#################################################################

shape:ConstraintShape
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:constraint ;

    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "If a constraint uid is present, it must be exactly one IRI." ;
    ] ;

    sh:property [
        sh:path odrl:leftOperand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            odrl:purpose
            odrl:dateTime
            odrl:spatial
            odrl:recipient
            odrl:count
            odrl:elapsedTime
            odrl:payAmount
        ) ;
        sh:severity sh:Violation ;
        sh:message "Each constraint must include exactly one leftOperand supported by the prototype." ;
    ] ;

    sh:property [
        sh:path odrl:operator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            odrl:eq
            odrl:neq
            odrl:lt
            odrl:lteq
            odrl:gt
            odrl:gteq
        ) ;
        sh:severity sh:Violation ;
        sh:message "Each constraint must include exactly one operator supported by the prototype." ;
    ] ;

    sh:property [
        sh:path odrl:unit ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "If unit is present, it must be exactly one IRI." ;
    ] ;

    sh:property [
        sh:path odrl:dataType ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "If dataType is present, it must be exactly one IRI." ;
    ] ;

    sh:property [
        sh:path odrl:status ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "If status is present, it must have at most one value." ;
    ] .

shape:ConstraintRightOperandShape
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:constraint ;
    sh:xone (
        [
            sh:property [
                sh:path odrl:rightOperand ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRIOrLiteral ;
            ] ;
            sh:property [
                sh:path odrl:rightOperandReference ;
                sh:maxCount 0 ;
            ]
        ]
        [
            sh:property [
                sh:path odrl:rightOperandReference ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
            ] ;
            sh:property [
                sh:path odrl:rightOperand ;
                sh:maxCount 0 ;
            ]
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "Each constraint must contain exactly one rightOperand or one rightOperandReference, but never both." .

shape:CountRightOperandShape
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:constraint ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path odrl:leftOperand ;
                    sh:hasValue odrl:count ;
                ]
            ]
        ]
        [
            sh:property [
                sh:path odrl:rightOperandReference ;
                sh:minCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path odrl:rightOperand ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 0 ;
            ]
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A count constraint must use a non-negative xsd:integer rightOperand, unless rightOperandReference is used." .

shape:DateTimeRightOperandShape
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:constraint ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path odrl:leftOperand ;
                    sh:hasValue odrl:dateTime ;
                ]
            ]
        ]
        [
            sh:property [
                sh:path odrl:rightOperandReference ;
                sh:minCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path odrl:rightOperand ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:date ;
            ]
        ]
        [
            sh:property [
                sh:path odrl:rightOperand ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:dateTime ;
            ]
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A dateTime constraint must use an xsd:date or xsd:dateTime rightOperand, unless rightOperandReference is used." .

shape:ElapsedTimeRightOperandShape
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:constraint ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path odrl:leftOperand ;
                    sh:hasValue odrl:elapsedTime ;
                ]
            ]
        ]
        [
            sh:property [
                sh:path odrl:rightOperandReference ;
                sh:minCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path odrl:rightOperand ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:duration ;
            ]
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "An elapsedTime constraint must use an xsd:duration rightOperand, unless rightOperandReference is used." .
